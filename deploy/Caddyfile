:80 {
    handle /api/* {
        reverse_proxy api:8080
    }
    handle /ws {
        reverse_proxy api:8080
    }
    handle /health {
        reverse_proxy api:8080
    }
    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}
