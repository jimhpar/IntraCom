    email admin@asf.run
}

# Domain calling.asf.run - Automatic Real Public SSL (Let's Encrypt / ZeroSSL)
calling.asf.run, calling.asf.run:8080, www.calling.asf.run {
    handle /api/* {
        reverse_proxy api:8080
    }
    handle /ws {
        reverse_proxy api:8080
    }
    handle /health {
        reverse_proxy api:8080
    }
    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}

# Direct IP fallback with internal cert
https://129.225.125.127:8080, :8080 {
    tls /etc/caddy/server.crt /etc/caddy/server.key

    handle /api/* {
        reverse_proxy api:8080
    }
    handle /ws {
        reverse_proxy api:8080
    }
    handle /health {
        reverse_proxy api:8080
    }
    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}
