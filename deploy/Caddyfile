:80 {
    # Proxy core backend and WebSocket signaling
    reverse_proxy /api/* api:8080
    reverse_proxy /ws api:8080
    reverse_proxy /health api:8080

    # Serve Flutter Web frontend directly in browser
    root * /srv/web
    file_server
    try_files {path} /index.html
}
